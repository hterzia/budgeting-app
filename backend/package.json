{
  "name": "budgeting-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "BIND_HOST=0.0.0.0 tsx watch src/server.ts",
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "merchant-normalization:seed": "tsx src/scripts/seedMerchantNormalization.ts",
    "merchant-normalization:backfill": "tsx src/scripts/backfillMerchantNormalization.ts",
    "transaction-classification:backfill": "tsx src/scripts/backfillTransactionClassification.ts",
    "recategorize:rules": "tsx src/scripts/recategorizeByRules.ts",
    "migrate:up": "tsx src/db/runMigrateSqlite.ts up",
    "migrate:down": "tsx src/db/runMigrateSqlite.ts down",
    "migrate:from-postgres": "tsx src/scripts/migrateFromPostgres.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "better-sqlite3": "^12.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "papaparse": "^5.5.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.2.2",
    "tsx": "^4.9.1",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
