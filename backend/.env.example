# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=budgeting
POSTGRES_USER=budgeting
POSTGRES_PASSWORD=budgeting

# Server Configuration
PORT=3001
NODE_ENV=development

# Embedding Configuration
EMBEDDING_ENDPOINT=http://localhost:8001/v1/embeddings
EMBEDDING_MODEL=nvidia/llama-embed-nemotron-8b

# LLM Categorization (cold-start fallback)
# OpenAI-compatible chat completions endpoint (separate from embedding model)
LLM_ENDPOINT=http://localhost:8001/v1/chat/completions
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Max transactions per LLM batch prompt (default: 20)
LLM_BATCH_SIZE=20
